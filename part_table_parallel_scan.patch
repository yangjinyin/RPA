+int ha_innopart::pq_leader_range_scan_init(uint keyno, void *&pq_ctx,
+                                    uint &n_threads) {
+  pq_ctx = nullptr;
+  update_thd();
+  auto trx = m_prebuilt->trx;
+  innobase_register_trx(ht, ha_thd(), trx);
+  trx_start_if_not_started_xa(trx, false, UT_LOCATION_HERE);
+  trx_assign_read_view(trx);
+
+  dict_index_t *index{nullptr};
+  dberr_t success{DB_SUCCESS};
+
+  auto pq_reader = ut::new_withkey<Parallel_reader>(
+      UT_NEW_THIS_FILE_PSI_KEY, Parallel_reader::available_threads(n_threads));
+
+  if (pq_reader == nullptr || !pq_reader->pq_have_event()) {
+    if (pq_reader) ut::delete_(pq_reader);
+    return (HA_ERR_OUT_OF_MEM);
+  }
+
+  pq_reader->key = keyno;
+
+  // Step 1: Collect all MRR ranges before iterating partitions
+  struct Range_info {
+    KEY_MULTI_RANGE range;
+    bool has_start_key;
+    bool has_end_key;
+  };
+  
+  std::vector<Range_info> ranges;
+  uint range_res{0};
+  
+  // Collect all ranges from MRR iterator
+  while (!(range_res = mrr_funcs.next(mrr_iter, &mrr_cur_range))) {
+    Range_info range_info;
+    range_info.range = mrr_cur_range;
+    range_info.has_start_key = mrr_cur_range.start_key.keypart_map != 0;
+    range_info.has_end_key = mrr_cur_range.end_key.keypart_map != 0;
+    ranges.push_back(range_info);
+  }
+
+  // If no ranges collected, return error
+  if (ranges.empty()) {
+    ut::delete_(pq_reader);
+    return (HA_ERR_GENERIC);
+  }
+
+  for (auto part_id = m_part_info->get_first_used_partition();
+       part_id < m_tot_parts;
+       part_id = m_part_info->get_next_used_partition(part_id)) {
+    auto err = change_active_index(part_id, keyno);
+    index = m_prebuilt->index;
+
+    if (err != 0) {
+      ut::delete_(pq_reader);
+      return (err);
+    }
+
+    if (dict_table_is_discarded(m_prebuilt->table)) {
+      ib_senderrf(ha_thd(), IB_LOG_LEVEL_ERROR, ER_TABLESPACE_DISCARDED,
+                  m_prebuilt->table->name.m_name);
+      ut::delete_(pq_reader);
+      return (HA_ERR_NO_SUCH_TABLE);
+    }
+
+    for (const auto &range_info : ranges) {
+      dtuple_t *range_start{nullptr};
+      dtuple_t *range_end{nullptr};
+      uint range_errno{0};
+      mem_heap_t *heap{nullptr};
+      btr_pcur_t *pcur{nullptr};
+
+      //auto start_key = mrr_cur_range.start_key.keypart_map ? &mrr_cur_range.start_key : 0;
+      //auto end_key = mrr_cur_range.end_key.keypart_map ? &mrr_cur_range.end_key : 0;
+      const KEY_MULTI_RANGE &cur_range = range_info.range;
+      auto start_key = range_info.has_start_key ? &cur_range.start_key : nullptr;
+      auto end_key = range_info.has_end_key ? &cur_range.end_key : nullptr;
+
+
+      // create search tuple for range_scan
+      if (index != nullptr) {
+        ulint search_tuple_n_fields;
+        search_tuple_n_fields = 2 * (index->table->get_n_cols() +
+                                   dict_table_get_n_v_cols(index->table));
+      if (!heap)
+        heap = mem_heap_create(DTUPLE_EST_ALLOC(search_tuple_n_fields),
+                               UT_LOCATION_HERE);
+      }
+
+      if (start_key) {
+        const uchar *key = start_key->key;
+        auto keypart_map = start_key->keypart_map;
+        uint key_len = calculate_key_len(table, keyno, keypart_map);
+
+        auto start_flag = start_key->flag;
+        if (!pq_reverse_scan) {
+          start_flag = (start_key->flag == HA_READ_AFTER_KEY)
+                          ? HA_READ_AFTER_KEY
+                          : HA_READ_KEY_OR_NEXT;
+        } else {
+          start_flag = (start_key->flag == HA_READ_AFTER_KEY)
+                          ? HA_READ_KEY_OR_PREV
+                          : HA_READ_BEFORE_KEY;
+        }
+
+        m_prebuilt->pq_index_read = true;
+        int err = index_read(table->record[0], key, key_len, start_flag);
+        m_prebuilt->pq_index_read = false;
+
+        if (!err) {
+          range_start = dtuple_copy(m_prebuilt->pq_tuple, heap);
+          range_start->n_fields_cmp = m_prebuilt->pq_tuple->n_fields_cmp;
+        } else if (pq_reverse_scan) {
+          range_errno = (err == HA_ERR_KEY_NOT_FOUND) ? 0 : err;
+        } else {
+          range_errno = err;
+        }
+      }
+
+      if (end_key && !range_errno) {
+        const uchar *key = end_key->key;
+        auto keypart_map = end_key->keypart_map;
+        uint key_len = calculate_key_len(table, keyno, keypart_map);
+
+        auto end_flag = end_key->flag;
+        if (!pq_reverse_scan) {
+          end_flag = (end_key->flag == HA_READ_BEFORE_KEY) ? HA_READ_KEY_OR_NEXT
+                                                          : HA_READ_AFTER_KEY;
+        } else {
+          end_flag = (end_key->flag == HA_READ_BEFORE_KEY) ? HA_READ_BEFORE_KEY
+                                                          : HA_READ_KEY_OR_PREV;
+        }
+
+        m_prebuilt->pq_index_read = true;
+        int err = index_read(table->record[0], key, key_len, end_flag);
+        m_prebuilt->pq_index_read = false;
+        if (!err) {
+          range_end = dtuple_copy(m_prebuilt->pq_tuple, heap);
+          range_end->n_fields_cmp = m_prebuilt->pq_tuple->n_fields_cmp;
+          pcur = m_prebuilt->pcur;
+        } else {
+          if (err == HA_ERR_KEY_NOT_FOUND) {
+            index_last(table->record[0]);
+            pcur = m_prebuilt->pcur;
+            range_errno = 0;
+          } else {
+            range_errno = err;
+          }
+        }
+      } else if (end_key == nullptr && !range_errno) {
+        index_last(table->record[0]);
+        pcur = m_prebuilt->pcur;
+      }
+
+      //add scan
+      Parallel_reader::Scan_range range_scan{range_start, range_end};
+      Parallel_reader::Config config(range_scan, index, 0, part_id);
+      config.m_range_errno = range_errno;
+      config.m_pcur = pcur;
+      config.m_pq_reverse_scan = pq_reverse_scan;
+
+      success = pq_reader->add_scan(trx, config, nullptr, false);
+
+      if (heap != nullptr) {
+        mem_heap_free(heap);
+      }
+
+      if (success != DB_SUCCESS) {
+        ut::delete_(pq_reader);
+        return (HA_ERR_GENERIC);
+      }
+    }
+  }
+
+  pq_reader->snapshot = trx->read_view;
+  if (pq_reverse_scan) pq_reader->pq_set_reverse_scan();
+  pq_ctx = pq_reader;
+  build_template(false);
+
+  if (pq_reader->max_splits() < n_threads) {
+    n_threads = pq_reader->max_splits() > 1 ? pq_reader->max_splits() : 1;
+  }
+
+  return (0);                                    
+}
+
+int ha_innopart::pq_leader_scan_init(uint keyno, void *&pq_ctx,
+                                     uint &n_threads) {
+  // full scan
+  if (pq_scan_type == PQ_SCAN_TYPE::PQ_FULL_SCAN)
+    return pq_leader_full_table_scan_init(keyno, pq_ctx, n_threads);
+
+  // index scan
+  if (pq_scan_type == PQ_SCAN_TYPE::PQ_INDEX_SCAN)
+    return pq_leader_index_scan_init(keyno, pq_ctx, n_threads);
+
+  // ref scan
+  if (pq_scan_type == PQ_SCAN_TYPE::PQ_REF_SCAN)
+    return pq_leader_ref_init(keyno, pq_ctx, n_threads);
+
+  // range scan (support for range scan in the future. todo)
+  if (pq_scan_type == PQ_SCAN_TYPE::PQ_RANGE_SCAN)
+    //return (HA_ERR_GENERIC);
+    return pq_leader_range_scan_init(keyno, pq_ctx, n_threads);
+
+  return 0;
+}
