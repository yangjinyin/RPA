+int ha_innopart::pq_worker_scan_init(uint keyno, void *scan_ctx) {
+  active_index = keyno;
+
+  auto pq_reader = static_cast<Parallel_reader *>(scan_ctx);
+
+  update_thd();
+  m_prebuilt->is_attach_ctx = false;
+  m_prebuilt->index = innobase_get_index(pq_reader->key);
+
+  auto trx = m_prebuilt->trx;
+  innobase_register_trx(ht, ha_thd(), trx);
+  trx_start_if_not_started_xa(trx, false, UT_LOCATION_HERE);
+
+  if (trx->read_view == nullptr && pq_reader != nullptr &&
+      pq_reader->snapshot != nullptr) {
+    trx_clone_read_view(trx, pq_reader->snapshot);
+  }
+
+  // build_template(true);
+
+  inited = handler::PQ_WORKER;
+
+  return (0);
+}
